{
  "manifest_version": 2,
  "name": "LitMag",
  "version": "2.0.1",
  "description": "A self-contained Zotero 10 AI copilot. Configure your own model endpoint and API key in Settings; all requests go directly from Zotero, no companion app required.",
  "author": "SciTerminal",
  "homepage_url": "https://github.com/zhaojiayuan19981123/litmag",
  "icons": {
    "48": "content/icon.svg",
    "96": "content/icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "litmag@zhaojiayuan19981123.github.io"
    }
  },
  "applications": {
    "zotero": {
      "id": "litmag@zhaojiayuan19981123.github.io",
      "update_url": "https://raw.githubusercontent.com/zhaojiayuan19981123/litmag/main/update.json",
      "strict_min_version": "10.0.6",
      "strict_max_version": "10.*"
    }
  }
}
